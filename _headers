# Netlify / Cloudflare Pages header rules.
# Vercel-brugere: se vercel.json — samme regler, andet format.
#
# VIGTIGT: hele mappen udgives som ÉT Pages-projekt — marsey.dk i roden og
# Marcel på /marcel. Cloudflare læser kun _headers i roden af build output,
# så dette er den eneste headerfil i projektet. Reglerne for Marcel står
# længere nede som /marcel/*.
#
# img-src har Twitchs to billed-CDN'er med, fordi klip-thumbnails hentes
# derfra. Uden dem bliver alle klipbilleder brudte i produktion, mens de ser
# fine ud lokalt uden CSP.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://static-cdn.jtvnw.net https://clips-media-assets2.twitch.tv; font-src 'self'; connect-src 'self'; frame-src player.twitch.tv www.twitch.tv embed.twitch.tv clips.twitch.tv; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Marcel-siden forbinder til Twitchs IRC over WebSocket, når man selv har
# bedt om det. Den tilladelse gives kun her, ikke på hele sitet.
/marcel/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://static-cdn.jtvnw.net https://clips-media-assets2.twitch.tv; font-src 'self'; connect-src 'self' wss://irc-ws.chat.twitch.tv; frame-src player.twitch.tv www.twitch.tv embed.twitch.tv clips.twitch.tv; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Live-data må aldrig caches — den er hele pointen med at siden er live.
/state.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

# Immutable assets. Skift filnavn ved ændring i stedet for at nulstille cachen.
# Begge sider har hver sin assets-mappe, og en regel matcher kun sin egen sti —
# /assets/* rammer ikke /marcel/assets/*. Derfor står de begge her.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/marcel/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Twitch-funktionen i functions/api/ styrer selv sin cache (60 sekunder på
# kanten). Browseren må ikke lægge et lag oveni — så bliver LIVE NU forkert.
/api/*
  Cache-Control: no-store

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Kildefiler skal aldrig serveres.
/assets/source/*
  X-Robots-Tag: noindex
