# Netlify / Cloudflare Pages header rules.
# Vercel-brugere: se vercel.json — samme regler, andet format.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src player.twitch.tv www.twitch.tv embed.twitch.tv clips.twitch.tv; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Live-data må aldrig caches — den er hele pointen med at siden er live.
/state.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

# Immutable assets. Skift filnavn ved ændring i stedet for at nulstille cachen.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Kildefiler skal aldrig serveres.
/assets/source/*
  X-Robots-Tag: noindex
